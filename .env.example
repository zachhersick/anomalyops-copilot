# Real semantic RAG configuration
ANOMALYOPS_RETRIEVAL_BACKEND=pgvector
ANOMALYOPS_DATABASE_URL=postgresql+psycopg://anomalyops:anomalyops@localhost:5432/anomalyops

ANOMALYOPS_AI_PROVIDER=openai
ANOMALYOPS_EMBEDDING_MODEL=text-embedding-3-small
ANOMALYOPS_EMBEDDING_DIMENSIONS=16
ANOMALYOPS_GROUNDED_ANSWER_MODEL=gpt-5-mini
ANOMALYOPS_TRIAGE_MODEL=gpt-5-mini

# Leave blank in this committed example.
# Set the real value only in your ignored local .env file.
OPENAI_API_KEY=

# Required only when using the normal /triage endpoint against
# the separate anomaly detection platform.
ANOMALYOPS_ANOMALY_API_BASE_URL=http://localhost:8001

# Offline manifest alternative:
# ANOMALYOPS_RETRIEVAL_BACKEND=manifest
# ANOMALYOPS_MANIFEST_PATH=outputs/chunks.json
# ANOMALYOPS_AI_PROVIDER=deterministic